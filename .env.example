# ProductRadar — copy this template to .env, then fill your own API keys.
# Recommended: run `python scripts/init_local_env.py` to generate local secrets.
# Never commit your .env or actual keys to GitHub.

# Required for research: DashScope (LLM) and Tavily (public web search).
DASHSCOPE_API_KEY=
TAVILY_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.5-plus

# Optional: use different models for different research stages.
PLANNING_MODEL=
RESEARCH_MODEL=
EVIDENCE_MODEL=
ANALYSIS_MODEL=
CRITIC_MODEL=
EVALUATION_MODEL=

# Optional backup provider (configure all three values or leave all empty).
FALLBACK_LLM_API_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Local Postgres / account registration secrets: generated by init_local_env.py.
# If you copy this file manually, supply long random values before starting.
POSTGRES_PASSWORD=
PRODUCTRADAR_INVITE_CODE=

# Only configure a real hostname when publishing with HTTPS / Caddy.
PRODUCTRADAR_DOMAIN=
# `false` is only for local HTTP (localhost). For public HTTPS use compose.public.yml.
PRODUCTRADAR_COOKIE_SECURE=false

# Local Python backend: `python main.py` uses port 8001.
# Docker Compose backend: http://localhost:8000
APP_HOST=127.0.0.1
APP_PORT=8001
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional external database; leave unset for local Docker/Postgres defaults.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:15432/productradar

MAX_ACTIVE_RESEARCH_TASKS_PER_USER=2
MAX_MODEL_CALLS=50
MAX_SEARCH_CALLS=15
MAX_PAGES_READ=15
RESERVED_SUPPLEMENTAL_SEARCH_CALLS=7
RESERVED_SUPPLEMENTAL_PAGE_READS=7
LANGGRAPH_STRICT_MSGPACK=true
LOG_LEVEL=INFO

# Optional cost estimation: actual CNY price per million tokens; 0 = unknown.
QWEN_INPUT_PRICE_PER_MILLION_CNY=0
QWEN_OUTPUT_PRICE_PER_MILLION_CNY=0
